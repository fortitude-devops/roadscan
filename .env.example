# ============================================================
#  Выбор провайдера распознавания
# ============================================================
# Варианты: local | openrouter | gemini | groq | openai | mistral | custom
#
# local — специализированный детектор дорожных повреждений на вашем компьютере.
# Быстрее, точнее на дорожных дефектах, работает без интернета и без квот.
# Положите .onnx в папку models/ — см. models/README.md
AI_PROVIDER=local

# Запасные провайдеры через запятую: если основной недоступен (или веса
# ещё не скачаны), сервис перейдёт к следующему автоматически.
AI_PROVIDER_FALLBACKS=openrouter,gemini

# ============================================================
#  Ключи. Достаточно того провайдера, который выбран выше
# ============================================================

# OpenRouter — рекомендуется. Бесплатно, без карты, одна модель openrouter/free
# сама выбирает доступную бесплатную модель с поддержкой изображений.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — очень быстрый, бесплатный. Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (платный). Ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Mistral. Ключ: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ============================================================
#  Локальный детектор
# ============================================================
# Путь к весам. Если не задан — берётся первый .onnx или .pt из models/
# LOCAL_MODEL_PATH=models/road_damage.onnx
# LOCAL_CONF=0.30           # порог уверенности: выше — меньше ложных срабатываний
# LOCAL_IOU=0.45            # порог подавления дублирующих рамок
# LOCAL_INPUT_SIZE=640      # если модель обучена на другом размере
# LOCAL_CLASS_NAMES=D00,D10,D20,D40,Repair   # если их нет в метаданных модели

# ============================================================
#  Тонкая настройка (менять обычно не нужно)
# ============================================================
# Переопределить модель конкретного провайдера:
# OPENROUTER_MODEL=openrouter/free
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# Любой другой OpenAI-совместимый сервис (в том числе локальный):
# AI_PROVIDER=custom
# CUSTOM_API_KEY=любая_строка
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama3.2-vision

# Повторы при временных сбоях
# AI_RETRIES=2
# AI_BACKOFF=1.5

# Аварийный режим демо: работать только на кэше, без сети
# OFFLINE_MODE=1
